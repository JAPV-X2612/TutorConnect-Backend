# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tutorconnect
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
# Alternatively, set a full connection URL (takes precedence over individual fields):
# DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/tutorconnect

# Controls TypeORM synchronize in DatabaseModule.
# Set to "true" only in local development when no migrations exist yet.
# Leave empty (false) in all other environments — use migrations instead.
DATABASE_SYNCHRONIZE=

# ── Clerk (Authentication) ────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── AWS S3 (File Storage) ─────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=

# ── Firebase Cloud Messaging (Push Notifications) ─────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Redis (Cache / Real-time session state) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Google Gemini (AI Embeddings for semantic search) ─────────────────────────
# Get your key at: https://aistudio.google.com
GEMINI_API_KEY=
